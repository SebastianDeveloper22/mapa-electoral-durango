rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.rol == 'admin';
    }

    function isEditorOrAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.rol in ['editor', 'admin'];
    }

    // ── Control de acceso: Roles ──────────────────────────────────────────────
    // Solo admin puede crear/editar/borrar roles

    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write, delete: if isAdmin();
    }

    // ── Módulo PP: Obras ──────────────────────────────────────────────────────

    match /obras/{obraId} {
      allow read: if isAuthenticated();
      allow create, update: if isEditorOrAdmin();
      allow delete: if isEditorOrAdmin();
    }

    // ── Módulo PP: Marcadores Rural ───────────────────────────────────────────

    match /marcadores_rural/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isEditorOrAdmin();
      allow delete: if isEditorOrAdmin();
    }

    // ── Módulo PP: Marcadores Top 100 Urbano ─────────────────────────────────

    match /marcadores_top100/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isEditorOrAdmin();
      allow delete: if isEditorOrAdmin();
    }

    // ── Módulo PP: Marcadores Generales ──────────────────────────────────────

    match /marcadores_generales/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isEditorOrAdmin();
      allow delete: if isEditorOrAdmin();
    }

    // ── Módulo PP: Papelera de auditoría ──────────────────────────────────────

    match /papelera/{papeleraId} {
      allow read: if isAuthenticated();
      allow create: if isEditorOrAdmin();
      allow update, delete: if isAdmin();
    }

    // ── Módulo Electoral: Elecciones ──────────────────────────────────────────

    match /elecciones/{eleccionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isEditorOrAdmin();

      match /casillas/{casillaId} {
        allow read: if isAuthenticated();
        allow write, delete: if isEditorOrAdmin();
      }

      match /resultados/{resultadoId} {
        allow read: if isAuthenticated();
        allow write, delete: if isEditorOrAdmin();
      }
    }

    // ── Módulo Electoral: Casillas (colección top-level) ──────────────────────

    match /casillas/{casillaId} {
      allow read: if isAuthenticated();
      allow create, update: if isEditorOrAdmin();
      allow delete: if isEditorOrAdmin();
    }

    // ── Módulo Electoral: Resultados (colección top-level) ────────────────────

    match /resultados/{resultadoId} {
      allow read: if isAuthenticated();
      allow create, update: if isEditorOrAdmin();
      allow delete: if isEditorOrAdmin();
    }

    // ── Denegar todo lo demás ─────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
